(ql:quickload :uiop)
(load "q2data.lisp")

(defun prepare (s)
  (map 'list #'uiop:split-string (uiop:split-string s :separator '(#\NewLine))))

(defun calc-order (line)
  (let ((ht (make-hash-table :test 'equalp)))
    (dolist (i line)
      (cond ((find #\> i) (let* ((parts (uiop:split-string i :separator '(#\>)))
                                 (slot (gethash (cadr parts) ht '())))
                            (setf (gethash (car parts) ht '()) (gethash (car parts) ht '()))
                            (setf (gethash (cadr parts) ht) (cons (car parts) slot))))
            ((find #\< i) (let* ((parts (uiop:split-string i :separator '(#\<)))
                                 (slot (gethash (car parts) ht '())))
                            (setf (gethash (cadr parts) ht '()) (gethash (cadr parts) ht '()))
                            (setf (gethash (car parts) ht) (cons (cadr parts) slot))))
            (T (error "Missing separator"))))
    (let ((vec (make-array (hash-table-count ht))))
      (maphash (lambda (k v)
                 (dolist (i v)
                   (let ((subv (gethash i ht '())))
                     (dolist (ii subv)
                       (unless (find ii v :test 'equalp) (setf v (cons ii v))))))
                 (setf (gethash k ht) v)) ht)
      (maphash (lambda (k v) (setf (aref vec (length v)) k)) ht)
      (read-from-string (format nil "~{~a~}" (coerce vec 'list))))))

(defun calc (s)
  (reduce #'+ (map 'list #'calc-order (prepare s))))

(format T "Q1: ~a~%" (calc data-q1))
(format T "Q2: ~a~%" (calc data-q2))
(format T "Q3: ~a~%" (calc data-q3))

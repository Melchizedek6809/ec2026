(define (->fixnum v)
  (cond ((flonum? v) (flonum->fixnum v))
        ((fixnum? v) v)
        (otherwise (raise :type-error))))

(define (total-pines has-pines)
  (let [(w (->fixnum (ceiling (sqrt has-pines))))]
    (* w w)))

(define (required-pines has-pines)
  (- (total-pines has-pines) has-pines))

(define (get-total-p1 pine-count-list)
  (fold-left + 0 (map required-pines pine-count-list)))

(define (p1) (get-total-p1 data-p1))

(define (calc-p2-req w)
  (- (* w w) (* (- w 2) (- w 2))))

(define (calc-p2 p)
  (let loop [(w 3)]
    (let [(g (calc-p2-req w))]
      (if (< g p)
          (loop (+ w 1))
          (- g p)))))

(define (p2)
  (fold-left + 0 (map calc-p2 data-p2)))

(define (calc-p3-req w)
  (- (* w w) 1))

(define (calc-p3 p)
  (let loop [(w 3)]
    (let [(g (calc-p3-req w))]
      (if (< g p)
          (loop (+ w 2))
          (- g p)))))

(define (p3)
  (fold-left + 0 (map calc-p3 data-p3)))

(display (p3))
